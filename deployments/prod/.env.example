# ============= Required - production secrets =============
# Database - MUST be strong, no default
POSTGRES_USER=labflow
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=labflow

# Object storage (SeaweedFS S3) credentials - MUST be strong, letters and digits only
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_MINIO_PASSWORD_16_CHARS_MIN
MINIO_BUCKET_CERTIFICATE=certificates
MINIO_BUCKET_RESERVATION=reservations
MINIO_BUCKET_USER=users

# Application Secrets - MUST be strong, 32+ chars random
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_32_CHAR_PLUS_RANDOM_JWT_SECRET
COOKIE_SECRET=CHANGE_ME_32_CHAR_PLUS_RANDOM_COOKIE_SECRET

# Turnstile - Cloudflare Turnstile for login protection
# Site key is public, baked at build time via VITE_TURNSTILE_SITE_KEY GitHub Variable
# Secret is private, required in prod, must NOT be bypassed
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=CHANGE_ME_CLOUDFLARE_TURNSTILE_SECRET
# Do NOT set BYPASS_TURNSTILE in prod - only for dev
# BYPASS_TURNSTILE is dev-only, enforced to fail if set in production

# ============= Container images =============
# Set to match your GHCR owner (lowercase). CI computes this automatically.
# For manual deploys, set to ghcr.io/<your-github-owner>/labflow-backend:latest
BACKEND_IMAGE=ghcr.io/your-org/labflow-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/labflow-frontend:latest

# ============= SMTP (optional, for quotation & OTP emails) =============
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ============= Deployment config =============
# Path on VPS where deployment files live (must match deploy.yml DEPLOY_PATH)
# All files are inside this single dir: docker-compose.yml, .env, backups/
# Default: ~/deployment/labflow
DEPLOY_PATH=~/deployment/labflow

# Note: nginx/certbot removed - you handle reverse proxy & TLS yourself.
# Backend exposed at 127.0.0.1:8080, Frontend at 127.0.0.1:3000
# Example nginx to proxy /api,/auth -> 8080 and / -> 3000 is in README and host-nginx-example.conf
